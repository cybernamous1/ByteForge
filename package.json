{
  "name": "byteforge",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "test:smoke": "node --experimental-vm-modules --no-warnings scripts/smoke.mjs",
    "verify": "npm test && npm run test:smoke && npm run build",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "@webcontainer/api": "^1.5.3",
    "jszip": "^3.10.1",
    "monaco-editor": "^0.52.2",
    "sql.js": "^1.13.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "vite": "^6.1.0"
  }
}
